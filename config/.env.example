TARGET_CHAT_ID=

# Safety & Performance Config
ALERT_INTERVAL_SECONDS=1.0
API_TIMEOUT_SECONDS=10.0
HEARTBEAT_INTERVAL_SECONDS=30.0
DEDUP_TTL_SECONDS=3600
DEDUP_MAX_SIZE=500
QUEUE_MAX_SIZE=100
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
