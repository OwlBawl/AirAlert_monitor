# Telegram API Credentials (from https://my.telegram.org)
API_ID=
API_HASH=

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Target Chat ID where alerts are delivered and bot commands are listened
# (e.g., -100xxxxxxxxxx for supergroup/channel or user ID for DM)
TARGET_CHAT_ID=

# Safety & Performance Config
ALERT_INTERVAL_SECONDS=1.0
API_TIMEOUT_SECONDS=10.0
HEARTBEAT_INTERVAL_SECONDS=30.0
MAX_MESSAGE_AGE_SECONDS=300.0
MAX_FLOOD_WAIT_SECONDS=60.0
KEYWORD_COOLDOWN_ALERT_SECONDS=60.0
KEYWORD_COOLDOWN_CANCEL_SECONDS=300.0
ALERT_BURST_MIN_INTERVAL_SECONDS=0.3
ALERT_BURST_CAPACITY=3
QUEUE_MAX_SIZE=100
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
